{
  "name": "ikaros-infra",
  "description": "ikaros-infra",
  "packageManager": "pnpm@11.27.1",
  "engines": {
    "node": "^22.18.0 || ^24.11.0 || >=26.0.0"
  },
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "postinstall": "node scripts/postinstall.mjs",
    "build": "pnpm -r run build",
    "test": "pnpm -r run test",
    "upgrade": "pnpm up -r && pnpm up -r -w",
    "lint:fix": "eslint \"packages/**/*.{js,jsx,ts,tsx,vue}\" --fix && prettier --write \"packages/**/*.{js,jsx,ts,tsx,vue}\""
  },
  "license": "MIT",
  "devDependencies": {
    "@ikaros-cli/eslint-plugin": "workspace:*",
    "@ikaros-cli/prettier-config": "workspace:*",
    "@types/node": "^22.20.4",
    "eslint": "^10.11.0",
    "prettier": "^3.9.8",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2"
  }
}
